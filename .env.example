# Bitwarden US by default. For Vaultwarden, enter your instance URL.
BW_SERVER=https://vault.bitwarden.com

# Use single quotes to keep literal $ and # characters in passwords.
BW_CLIENTID='user.replace-with-your-personal-client-id'
BW_CLIENTSECRET='replace-with-your-personal-client-secret'
BW_PASSWORD='replace-with-your-master-password'
KDBX_PASSWORD='replace-with-a-separate-backup-password'

# Set these to your host user's numeric UID/GID if different from 1000.
BACKUP_UID=1000
BACKUP_GID=1000
